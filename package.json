{
  "name": "prontuario-qi",
  "version": "1.0.0",
  "private": true,
  "description": "Prontuário Qi — documentação clínica local para acupuntura, com pipeline de PLN inspecionável",
  "scripts": {
    "setup": "python setup.py",
    "dev": "concurrently -k -n api,web -c green,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/run-api.mjs",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "node scripts/run-tests.mjs",
    "eval": "node scripts/run-eval.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
