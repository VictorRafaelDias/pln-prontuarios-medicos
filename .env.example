# Prontuário Qi — configuração (copie para .env)

# Chave da API da Anthropic. Fica SOMENTE no backend (nunca vai ao navegador).
# Sem chave, o sistema funciona 100% com o pipeline clássico de PLN ("Somente PLN clássico").
ANTHROPIC_API_KEY=

# Modelo usado na extração (etapa 11). Opções do mesmo padrão de preço:
#   claude-opus-5-5 (padrão, mais capaz) · claude-sonnet-5-5 (mais barato) · claude-haiku-5-5 (mais rápido/barato)
ANTHROPIC_MODEL=claude-opus-5-5

# Esforço de raciocínio da extração: low | medium | high  (low = mais rápido/barato)
ANTHROPIC_EFFORT=low

# Preço por milhão de tokens (US$) — usado só para ESTIMAR o custo na tela. Ajuste se mudar de modelo.
# Padrões embutidos: opus-5-5 = 4/20 · sonnet-5-5 = 2/10 · haiku-5-5 = 0.10/0.50
# ANTHROPIC_PRICE_IN_PER_MTOK=4.00
# ANTHROPIC_PRICE_OUT_PER_MTOK=20.00

# Pedir ao servidor que reexecute em outro modelo se a requisição for recusada por classificadores de segurança.
ANTHROPIC_USE_FALLBACKS=true

# Banco de dados local (SQLite) e porta da API
DATABASE_URL=sqlite:///backend/data/prontuario.db
API_PORT=8010
